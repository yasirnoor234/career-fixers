# Gmail SMTP Configuration
# Copy this file to .env.local and fill in your Gmail App Password for ceo.careerfixers.com@gmail.com
# Note: Generate a 16-character App Password at: https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ceo.careerfixers@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
RECIPIENT_EMAIL=ceo.careerfixers@gmail.com

